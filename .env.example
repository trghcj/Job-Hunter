# Copy to .env and fill in. Never commit .env.
# Supabase: use the SESSION POOLER string (port 5432). Direct connection is IPv6-only and
# fails from GitHub Actions/Render; the transaction pooler (6543) breaks psycopg/migrations.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Local example: postgresql+psycopg://postgres:yourpassword@localhost:5432/jobhunter
DATABASE_URL=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RESEND_API_KEY=
GEMINI_API_KEY=
SETTINGS_KEY=
